<!--perfil.html-->
<!DOCTYPE html>
<html lang="pt-br" data-theme="{{ current_user.tema if current_user.is_authenticated else 'light' }}">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Meu Perfil — Meu Drive</title>
    <link rel="icon" type="image/png" href="{{ url_for('static', filename='img/favicon.png') }}">
    <link rel="shortcut icon" href="{{ url_for('static', filename='img/favicon.ico') }}">
<script src="{{ url_for('static', filename='js/lucide.min.js') }}"></script>
    <link rel="stylesheet" href="{{ url_for('static', filename='css/style.css') }}">
    <style>
        .password-wrapper { position: relative; }
        .password-wrapper .form-input { padding-right: 44px; }
        .btn-toggle-senha {
            position: absolute; right: 12px; top: 50%; transform: translateY(-50%);
            background: none; border: none; cursor: pointer;
            color: var(--text-secondary); padding: 4px; line-height: 1;
            display: flex; align-items: center; transition: color 0.2s;
        }
        .btn-toggle-senha:hover { color: var(--text); }
    </style>
</head>
<body>
    <div class="app">

        <!-- SIDEBAR -->
        <aside class="sidebar" id="sidebar">
            <div class="logo">
                <span class="logo-icon"><i data-lucide="cloud" style="width:28px;height:28px;color:var(--primary);"></i></span>
                <span class="logo-text">Meu Drive</span>
            </div>
            <nav class="sidebar-nav">
                <a href="{{ url_for('file.explorar') }}" class="nav-item">
                    <span class="nav-icon"><i data-lucide="folder"></i></span>
                    <span class="nav-text">Meus arquivos</span>
                </a>
                <a href="{{ url_for('main.objetivos') }}" class="nav-item">
                    <span class="nav-icon"><i data-lucide="list-checks"></i></span>
                    <span class="nav-text">Objetivos</span>
                </a>
                <a href="#" class="nav-item" style="opacity: 0.6; cursor: not-allowed;">
                    <span class="nav-icon"><i data-lucide="star"></i></span>
                    <span class="nav-text">Favoritos</span>
                    <span class="nav-badge">Em breve</span>
                </a>
                <a href="#" class="nav-item" style="opacity: 0.6; cursor: not-allowed;">
                    <span class="nav-icon"><i data-lucide="trash-2"></i></span>
                    <span class="nav-text">Lixeira</span>
                    <span class="nav-badge">Em breve</span>
                </a>
            </nav>
            <div class="sidebar-footer">
                <a href="{{ url_for('auth.perfil') }}" class="user-info user-info-link active">
                    <span class="user-icon"><i data-lucide="circle-user-round"></i></span>
                    <span class="user-name">{{ current_user.nome if current_user.is_authenticated else 'Usuário' }}</span>
                </a>
                <a href="{{ url_for('auth.logout') }}" class="logout-link">
                    <span class="logout-icon"><i data-lucide="log-out"></i></span>
                    <span>Sair</span>
                </a>
            </div>
        </aside>

        <!-- MAIN -->
        <main class="main">
            <header class="topbar">
                <button class="mobile-menu-btn" id="mobile-menu-btn" aria-label="Menu">
                    <i data-lucide="menu"></i>
                </button>
                <div style="flex: 1; display:flex; align-items:center; gap:8px;">
                    <i data-lucide="circle-user-round" style="width:20px;height:20px;color:var(--primary);"></i>
                    <span style="font-weight: 600; font-size: 1rem;">Meu Perfil</span>
                </div>
            </header>

            <div class="content" style="max-width: 1200px;">

                {% with messages = get_flashed_messages(with_categories=true) %}
                {% if messages %}
                {% for category, message in messages %}
                <div class="alert alert-{{ 'success' if category == 'success' else 'error' if category == 'error' else 'info' }}" style="margin-bottom: 20px;">
                    {{ message }}
                </div>
                {% endfor %}
                {% endif %}
                {% endwith %}

                <!-- Grid de 2 colunas no desktop -->
                <div class="perfil-grid">
                    <!-- COLUNA ESQUERDA -->
                    <div class="perfil-column">
                        <!-- Nome de exibição -->
                        <div class="form-section">
                            <div class="form-section-header">
                                <span class="form-section-icon"><i data-lucide="pencil" style="width:28px;height:28px;color:var(--primary);"></i></span>
                                <div>
                                    <h2 class="form-section-title">Nome de exibição</h2>
                                    <p class="form-section-desc">Como seu nome aparece na interface.</p>
                                </div>
                            </div>
                            <form method="POST" action="{{ url_for('auth.perfil') }}">
                                <input type="hidden" name="csrf_token" value="{{ csrf_token() }}">
                                <input type="hidden" name="acao" value="nome">
                                <div class="form-group">
                                    <label class="form-label" for="nome">Nome de exibição</label>
                                    <input type="text" id="nome" name="nome" class="form-input"
                                        value="{{ current_user.nome }}" required maxlength="50" placeholder="Como quer ser chamado?">
                                    <div class="form-hint">
                                        <i data-lucide="info" style="width:14px;height:14px;flex-shrink:0;"></i>
                                        <span>Nome de usuário: <strong>{{ current_user.username }}</strong></span>
                                    </div>
                                </div>
                                <button type="submit" class="btn-primary" style="width: 100%; justify-content: center; margin-top: 8px;">
                                    <i data-lucide="save" style="width:16px;height:16px;"></i> Salvar nome
                                </button>
                            </form>
                        </div>

                        <!-- Preferência de Tema -->
                        <div class="form-section">
                            <div class="form-section-header">
                                <span class="form-section-icon"><i data-lucide="palette" style="width:28px;height:28px;color:var(--primary);"></i></span>
                                <div>
                                    <h2 class="form-section-title">Aparência</h2>
                                    <p class="form-section-desc">Escolha o tema do sistema.</p>
                                </div>
                            </div>
                            <form method="POST" action="{{ url_for('auth.perfil') }}">
                                <input type="hidden" name="csrf_token" value="{{ csrf_token() }}">
                                <input type="hidden" name="acao" value="tema">
                                <div class="form-group">
                                    <label class="form-label">Tema</label>
                                    <div style="display: flex; gap: 12px;">
                                        <label class="theme-option" style="flex: 1; cursor: pointer;">
                                            <input type="radio" name="tema" value="light"
                                                {{ 'checked' if current_user.tema == 'light' else '' }}
                                                style="position: absolute; opacity: 0; pointer-events: none;">
                                            <div class="theme-card" data-theme-option="light">
                                                <div class="theme-preview theme-preview-light">
                                                    <div style="background: white; height: 8px; border-radius: 4px 4px 0 0;"></div>
                                                    <div style="background: #f5f5f5; flex: 1; border-radius: 0 0 4px 4px;"></div>
                                                </div>
                                                <div class="theme-label">
                                                    <i data-lucide="sun" style="width:16px;height:16px;"></i>
                                                    <span>Claro</span>
                                                </div>
                                            </div>
                                        </label>
                                        <label class="theme-option" style="flex: 1; cursor: pointer;">
                                            <input type="radio" name="tema" value="dark"
                                                {{ 'checked' if current_user.tema == 'dark' else '' }}
                                                style="position: absolute; opacity: 0; pointer-events: none;">
                                            <div class="theme-card" data-theme-option="dark">
                                                <div class="theme-preview theme-preview-dark">
                                                    <div style="background: #1a1a1a; height: 8px; border-radius: 4px 4px 0 0;"></div>
                                                    <div style="background: #0a0a0a; flex: 1; border-radius: 0 0 4px 4px;"></div>
                                                </div>
                                                <div class="theme-label">
                                                    <i data-lucide="moon" style="width:16px;height:16px;"></i>
                                                    <span>Escuro</span>
                                                </div>
                                            </div>
                                        </label>
                                    </div>
                                </div>
                                <button type="submit" class="btn-primary" style="width: 100%; justify-content: center; margin-top: 8px;">
                                    <i data-lucide="check" style="width:16px;height:16px;"></i> Salvar tema
                                </button>
                            </form>
                        </div>

                        <!-- 2FA -->
                        <div class="form-section">
                            <div class="form-section-header">
                                <span class="form-section-icon"><i data-lucide="shield" style="width:28px;height:28px;color:var(--primary);"></i></span>
                                <div>
                                    <h2 class="form-section-title">Autenticação de Dois Fatores</h2>
                                    <p class="form-section-desc">Adicione segurança extra à sua conta.</p>
                                </div>
                            </div>
                            {% if not current_user.tem_2fa_ativo %}
                                <p style="margin-bottom: 16px; color: var(--text-secondary); font-size: 0.9rem;">
                                    O 2FA exige um código do seu celular além da senha.
                                </p>
                                <form method="POST" action="{{ url_for('auth.ativar_2fa') }}">
                                    <input type="hidden" name="csrf_token" value="{{ csrf_token() }}">
                                    <button type="submit" class="btn-primary" style="width: 100%; justify-content: center;">
                                        <i data-lucide="shield-check" style="width:18px;height:18px;"></i> Ativar 2FA
                                    </button>
                                </form>
                            {% else %}
                                <div class="alert alert-success" style="margin-bottom: 16px;">
                                    <i data-lucide="shield-check" style="width:18px;height:18px;"></i>
                                    <span>2FA está ativo!</span>
                                </div>

                                <details style="margin-bottom: 16px; border: 1px solid var(--border); border-radius: 8px; padding: 12px;">
                                    <summary style="cursor: pointer; font-weight: 600; color: var(--text); list-style: none; display: flex; align-items: center; gap: 8px;">
                                        <i data-lucide="key" style="width:16px;height:16px;"></i>
                                        <span>Códigos de backup ({{ current_user.backup_codes|length }})</span>
                                        <i data-lucide="chevron-down" style="width:16px;height:16px; margin-left: auto;"></i>
                                    </summary>
                                    <div style="margin-top: 16px; padding-top: 12px; border-top: 1px solid var(--border);">
                                        <p style="font-size: 0.85rem; color: var(--text-secondary); margin-bottom: 12px;">
                                            Use se perder acesso ao autenticador.
                                        </p>
                                        <div style="display: grid; grid-template-columns: repeat(2, 1fr); gap: 8px; margin-bottom: 12px;">
                                            {% for code in current_user.backup_codes %}
                                            <div style="background: var(--bg); border: 1px solid var(--border); padding: 8px; border-radius: 6px; font-family: 'Courier New', monospace; font-weight: 600; text-align: center; font-size: 0.85rem;">
                                                {{ code }}
                                            </div>
                                            {% endfor %}
                                        </div>
                                        <form method="POST" action="{{ url_for('auth.regenerar_backup_codes') }}">
                                            <input type="hidden" name="csrf_token" value="{{ csrf_token() }}">
                                            <button type="submit" class="btn-secondary" style="width: 100%; justify-content: center;" onclick="return confirm('Os códigos antigos deixarão de funcionar.')">
                                                <i data-lucide="refresh-cw" style="width:16px;height:16px;"></i> Regenerar
                                            </button>
                                        </form>
                                    </div>
                                </details>

                                <form method="POST" action="{{ url_for('auth.desativar_2fa') }}"
                                      onsubmit="return confirm('⚠️ Tem certeza? Sua conta ficará menos segura.')">
                                    <input type="hidden" name="csrf_token" value="{{ csrf_token() }}">
                                    <button type="submit" class="btn-danger" style="width: 100%; justify-content: center;">
                                        <i data-lucide="shield-off" style="width:18px;height:18px;"></i> Desativar 2FA
                                    </button>
                                </form>
                            {% endif %}
                        </div>
                    </div>

                    <!-- COLUNA DIREITA -->
                    <div class="perfil-column">
                        <!-- Alterar senha -->
                        <div class="form-section" style="height: fit-content;">
                            <div class="form-section-header">
                                <span class="form-section-icon"><i data-lucide="lock" style="width:28px;height:28px;color:var(--primary);"></i></span>
                                <div>
                                    <h2 class="form-section-title">Alterar senha</h2>
                                    <p class="form-section-desc">Use uma senha forte com no mínimo 12 caracteres.</p>
                                </div>
                            </div>
                            <form method="POST" action="{{ url_for('auth.perfil') }}" id="form-senha">
                        <input type="hidden" name="csrf_token" value="{{ csrf_token() }}">
                        <input type="hidden" name="acao" value="senha">

                        <div class="form-group">
                            <label class="form-label" for="senha_atual">Senha atual</label>
                            <div class="password-wrapper">
                                <input type="password" id="senha_atual" name="senha_atual" class="form-input"
                                    required placeholder="Digite sua senha atual" autocomplete="current-password">
                                <button type="button" class="btn-toggle-senha" id="btn-toggle-atual" title="Mostrar/ocultar">
                                    <i data-lucide="eye" id="icon-toggle-atual" style="width:18px;height:18px;"></i>
                                </button>
                            </div>
                            <div class="form-error" id="senha-atual-error"></div>
                        </div>

                        <div class="form-group">
                            <label class="form-label" for="nova_senha">Nova senha</label>
                            <div class="password-wrapper">
                                <input type="password" id="nova_senha" name="nova_senha" class="form-input"
                                    required placeholder="Mínimo 12 caracteres" autocomplete="new-password">
                                <button type="button" class="btn-toggle-senha" id="btn-toggle-nova" title="Mostrar/ocultar">
                                    <i data-lucide="eye" id="icon-toggle-nova" style="width:18px;height:18px;"></i>
                                </button>
                            </div>
                            <div class="form-error" id="nova-senha-error"></div>
                            <div id="password-strength" style="margin-top: 8px; display: none;">
                                <div style="display: flex; gap: 4px; margin-bottom: 6px;">
                                    <div class="strength-bar" id="bar-1" style="height:4px; flex:1; border-radius:2px; background: var(--border);"></div>
                                    <div class="strength-bar" id="bar-2" style="height:4px; flex:1; border-radius:2px; background: var(--border);"></div>
                                    <div class="strength-bar" id="bar-3" style="height:4px; flex:1; border-radius:2px; background: var(--border);"></div>
                                    <div class="strength-bar" id="bar-4" style="height:4px; flex:1; border-radius:2px; background: var(--border);"></div>
                                </div>
                                <ul id="password-rules" style="font-size:0.75rem; color: var(--text-secondary); padding-left: 16px; margin: 0;">
                                    <li id="rule-len">Mínimo 12 caracteres</li>
                                    <li id="rule-upper">Uma letra maiúscula</li>
                                    <li id="rule-lower">Uma letra minúscula</li>
                                    <li id="rule-num">Um número</li>
                                    <li id="rule-special">Um caractere especial (!@#$%...)</li>
                                </ul>
                            </div>
                        </div>

                        <div class="form-group">
                            <label class="form-label" for="confirmar_senha">Confirmar nova senha</label>
                            <div class="password-wrapper">
                                <input type="password" id="confirmar_senha" name="confirmar_senha" class="form-input"
                                    required placeholder="Repita a nova senha" autocomplete="new-password">
                                <button type="button" class="btn-toggle-senha" id="btn-toggle-confirmar" title="Mostrar/ocultar">
                                    <i data-lucide="eye" id="icon-toggle-confirmar" style="width:18px;height:18px;"></i>
                                </button>
                            </div>
                            <div class="form-error" id="confirmar-senha-error"></div>
                        </div>

                        <button type="submit" class="btn-primary" style="width: 100%; justify-content: center; margin-top: 8px;">
                            <i data-lucide="shield-check" style="width:16px;height:16px;"></i> Alterar senha
                        </button>
                    </form>
                        </div>
                    </div>
                </div>
            </div>
        </main>
    </div>

    <style>
        /* Grid responsivo para perfil */
        .perfil-grid {
            display: grid;
            grid-template-columns: 1fr;
            gap: 24px;
        }

        @media (min-width: 900px) {
            .perfil-grid {
                grid-template-columns: 1fr 1fr;
                align-items: start;
            }
        }

        .perfil-column {
            display: flex;
            flex-direction: column;
            gap: 24px;
        }

        .form-section {
            background: var(--card);
            border: 1px solid var(--border);
            border-radius: 12px;
            padding: 24px;
        }
    </style>

    <script src="{{ url_for('static', filename='js/main.js') }}"></script>
    <script>
        lucide.createIcons();
                        <i data-lucide="shield" style="width:20px;height:20px;"></i> Autenticação de Dois Fatores (2FA)
                    </h2>
                </div>

                <div class="section-body">
                    {% if not current_user.tem_2fa_ativo %}
                        <p style="margin-bottom: 16px; color: var(--text-secondary);">
                            Adicione uma camada extra de segurança à sua conta. O 2FA exige um código do seu celular além da senha.
                        </p>
                        <form method="POST" action="{{ url_for('auth.ativar_2fa') }}">
                            <input type="hidden" name="csrf_token" value="{{ csrf_token() }}">
                            <button type="submit" class="btn-primary">
                                <i data-lucide="shield-check" style="width:18px;height:18px;"></i> Ativar 2FA
                            </button>
                        </form>
                    {% else %}
                        <div class="alert alert-success" style="margin-bottom: 16px;">
                            <i data-lucide="shield-check" style="width:18px;height:18px;"></i>
                            <span>2FA está ativo! Sua conta está mais segura.</span>
                        </div>

                        <!-- Códigos de backup -->
                        <details style="margin-bottom: 16px; border: 1px solid var(--border); border-radius: 8px; padding: 12px;">
                            <summary style="cursor: pointer; font-weight: 600; color: var(--text); list-style: none; display: flex; align-items: center; gap: 8px;">
                                <i data-lucide="key" style="width:16px;height:16px;"></i>
                                <span>Ver códigos de backup</span>
                                <i data-lucide="chevron-down" style="width:16px;height:16px; margin-left: auto;"></i>
                            </summary>
                            <div style="margin-top: 16px; padding-top: 12px; border-top: 1px solid var(--border);">
                                <p style="font-size: 0.85rem; color: var(--text-secondary); margin-bottom: 12px;">
                                    Use estes códigos se perder acesso ao autenticador. Cada código pode ser usado apenas uma vez.
                                </p>
                                <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(120px, 1fr)); gap: 8px; margin-bottom: 12px;">
                                    {% for code in current_user.backup_codes %}
                                    <div style="background: var(--bg); border: 1px solid var(--border); padding: 8px; border-radius: 6px; font-family: 'Courier New', monospace; font-weight: 600; text-align: center; font-size: 0.9rem;">
                                        {{ code }}
                                    </div>
                                    {% endfor %}
                                </div>
                                <form method="POST" action="{{ url_for('auth.regenerar_backup_codes') }}" style="margin-top: 12px;">
                                    <input type="hidden" name="csrf_token" value="{{ csrf_token() }}">
                                    <button type="submit" class="btn-secondary" onclick="return confirm('Tem certeza? Os códigos antigos deixarão de funcionar.')">
                                        <i data-lucide="refresh-cw" style="width:16px;height:16px;"></i> Regenerar códigos
                                    </button>
                                </form>
                            </div>
                        </details>

                        <form method="POST" action="{{ url_for('auth.desativar_2fa') }}"
                              onsubmit="return confirm('⚠️ Tem certeza que deseja desativar o 2FA? Sua conta ficará menos segura.')">
                            <input type="hidden" name="csrf_token" value="{{ csrf_token() }}">
                            <button type="submit" class="btn-danger">
                                <i data-lucide="shield-off" style="width:18px;height:18px;"></i> Desativar 2FA
                            </button>
                        </form>
                    {% endif %}
                </div>
            </div>
        </main>
    </div>

    <script src="{{ url_for('static', filename='js/main.js') }}"></script>
    <script>
        lucide.createIcons();

        // Mobile menu
        const mobileBtn = document.getElementById('mobile-menu-btn');
        const sidebar = document.getElementById('sidebar');
        if (mobileBtn && sidebar) {
            mobileBtn.addEventListener('click', () => sidebar.classList.toggle('active'));
            document.addEventListener('click', (e) => {
                if (window.innerWidth <= 768 && !sidebar.contains(e.target) && !mobileBtn.contains(e.target))
                    sidebar.classList.remove('active');
            });
        }

        // Selecionar tema visualmente
        document.querySelectorAll('.theme-option').forEach(option => {
            const input = option.querySelector('input[type="radio"]');
            const card = option.querySelector('.theme-card');

            // Estado inicial
            if (input.checked) {
                card.classList.add('selected');
            }

            option.addEventListener('click', () => {
                // Remove seleção de todos
                document.querySelectorAll('.theme-card').forEach(c => c.classList.remove('selected'));
                // Adiciona na opção clicada
                card.classList.add('selected');
                input.checked = true;
            });
        });



        // Toggle senhas
        function setupToggle(btnId, inputId, iconId) {
            const btn = document.getElementById(btnId);
            const input = document.getElementById(inputId);
            const icon = document.getElementById(iconId);
            if (!btn) return;
            btn.addEventListener('click', () => {
                if (input.type === 'password') { input.type = 'text'; icon.setAttribute('data-lucide', 'eye-off'); }
                else { input.type = 'password'; icon.setAttribute('data-lucide', 'eye'); }
                lucide.createIcons();
            });
        }
        setupToggle('btn-toggle-atual', 'senha_atual', 'icon-toggle-atual');
        setupToggle('btn-toggle-nova', 'nova_senha', 'icon-toggle-nova');
        setupToggle('btn-toggle-confirmar', 'confirmar_senha', 'icon-toggle-confirmar');

        // Validação de senha
        document.addEventListener('DOMContentLoaded', function () {
            const novaSenhaInput = document.getElementById('nova_senha');
            const confirmarInput = document.getElementById('confirmar_senha');
            const novaSenhaError = document.getElementById('nova-senha-error');
            const confirmarError = document.getElementById('confirmar-senha-error');
            const formSenha = document.getElementById('form-senha');

            function showError(input, div, msg) { input.classList.add('error'); div.textContent = msg; div.style.display = 'block'; }
            function clearError(input, div) { input.classList.remove('error'); div.textContent = ''; div.style.display = 'none'; }

            function checkPassword(senha) {
                return { len: senha.length >= 12, upper: /[A-Z]/.test(senha), lower: /[a-z]/.test(senha), num: /\d/.test(senha), special: /[^A-Za-z0-9]/.test(senha) };
            }

            function updateStrengthUI(senha) {
                const el = document.getElementById('password-strength');
                if (!senha) { el.style.display = 'none'; return; }
                el.style.display = 'block';
                const r = checkPassword(senha);
                const rules = { 'rule-len': r.len, 'rule-upper': r.upper, 'rule-lower': r.lower, 'rule-num': r.num, 'rule-special': r.special };
                Object.entries(rules).forEach(([id, ok]) => { document.getElementById(id).style.color = ok ? '#22c55e' : 'var(--text-secondary)'; });
                const score = Object.values(r).filter(Boolean).length;
                const colors = ['', '#ef4444', '#f97316', '#eab308', '#22c55e'];
                for (let i = 1; i <= 4; i++) { document.getElementById('bar-' + i).style.background = i <= score ? colors[score] : 'var(--border)'; }
            }

            function validateNovaSenha() {
                const senha = novaSenhaInput.value;
                if (!senha) { showError(novaSenhaInput, novaSenhaError, 'Digite a nova senha'); return false; }
                const r = checkPassword(senha);
                if (!r.len) { showError(novaSenhaInput, novaSenhaError, 'Mínimo 12 caracteres'); return false; }
                if (!r.upper) { showError(novaSenhaInput, novaSenhaError, 'Adicione uma letra maiúscula'); return false; }
                if (!r.lower) { showError(novaSenhaInput, novaSenhaError, 'Adicione uma letra minúscula'); return false; }
                if (!r.num) { showError(novaSenhaInput, novaSenhaError, 'Adicione um número'); return false; }
                if (!r.special) { showError(novaSenhaInput, novaSenhaError, 'Adicione um caractere especial'); return false; }
                clearError(novaSenhaInput, novaSenhaError); return true;
            }

            function validateConfirmar() {
                if (!confirmarInput.value) { showError(confirmarInput, confirmarError, 'Confirme a nova senha'); return false; }
                if (confirmarInput.value !== novaSenhaInput.value) { showError(confirmarInput, confirmarError, 'As senhas não coincidem'); return false; }
                clearError(confirmarInput, confirmarError); return true;
            }

            novaSenhaInput.addEventListener('input', () => { updateStrengthUI(novaSenhaInput.value); validateNovaSenha(); if (confirmarInput.value) validateConfirmar(); });
            confirmarInput.addEventListener('input', validateConfirmar);
            formSenha.addEventListener('submit', function (e) { const ok = [validateNovaSenha(), validateConfirmar()].every(Boolean); if (!ok) e.preventDefault(); });
        });
    </script>
</body>
</html>